# Godot 4+ specific ignores
.godot/
/android/

# Local Claude Code MCP config (machine-specific paths)
.mcp.json

# Old art pack, kept locally only
assets-old/

# Screenshots produced by tests and tools (the README uses docs/images/)
tests/screenshots/

# Art source material that the game does not load
assets/preview/
assets/source_sheets/
assets/data/
assets/README.md
assets/worlds/*/source_assets_sheet.png*
assets/worlds/*/source_background.png*
assets/worlds/*/sample_level.json
assets/worlds/*/level_config.json
assets/worlds/world_progression.json
assets/environment/*_original.png*
assets/environment/tileset_preview_3x.png*
assets/boss/shorty_original_six_pose_sheet.png*
# Electronics set: the game uses parts/, symbols/ and manifest.json only
# (the 4x folders and SVG sources also carry a .gdignore; the atlases import as "skip")
assets/interactive/electronics/parts_hd/
assets/interactive/electronics/symbols_hd/
assets/interactive/electronics/source/
assets/interactive/electronics/parts_atlas.png*
assets/interactive/electronics/symbols_atlas.png*
assets/interactive/electronics/atlas_index.json

# Godot editor and OS clutter
*.tmp
.DS_Store
Thumbs.db

# Subagent reports saved for the project owner to read (local only)
reports/
